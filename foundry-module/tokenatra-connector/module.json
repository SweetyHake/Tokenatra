    }
  ],
  "readme": "README.md",
  "url": "https://github.com/SweetyHake/Tokenatra",
  "manifest": "https://raw.githubusercontent.com/SweetyHake/Tokenatra/main/foundry-module/tokenatra-connector/module.json",
